# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://kineticshubs:choose-a-strong-password@localhost:5432/kineticshubs

# ── API server ────────────────────────────────────────────────────────────────
# Port the Express server listens on (nginx proxies to this)
PORT=8080

# Session cookie encryption key — generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-secret-at-least-64-chars

# Required for self-hosted HTTPS. The app trusts the HTTPS reverse-proxy hop.
COOKIE_SECURE=true

# Self-hosted production rejects direct HTTP requests and redirects them to APP_URL.
# The reverse proxy must pass X-Forwarded-Proto: https.
# ENFORCE_HTTPS=true

# Canonical public HTTPS origin used for sign-in and Hub registration links.
# APP_URL is preferred; PUBLIC_APP_URL remains supported as an alias.
# APP_URL=https://hubs.example.com
# PUBLIC_APP_URL=https://hubs.example.com

# ── Administrator sign-in mode ───────────────────────────────────────────────
# Default: secure, emailed magic links for every account.
# For the self-hosted Linux deployment only, set AUTH_MODE=direct_admin to let
# existing administrator accounts sign in with their email address only.
# This is less secure: anyone who knows an administrator's email can sign in.
# Regular attendee accounts are never eligible for direct sign-in.
# AUTH_MODE=direct_admin

# ── One-time administrator recovery ───────────────────────────────────────────
# If Jassen Elliott's administrator record is missing from a production database,
# set this to true for one API restart. It creates only that exact account in
# AI Leaders Forum and never changes existing records. Remove this setting and
# restart the API after confirming sign-in works.
# RECOVERY_ADMIN_BOOTSTRAP=true

# ── Email ─────────────────────────────────────────────────────────────────────
# Select "graph" for Microsoft Graph application-permission delivery, or leave
# unset/use "smtp" for the existing SMTP transport.
# EMAIL_PROVIDER=graph

# Microsoft Graph application-permission delivery
# GRAPH_TENANT_ID=your-tenant-id
# GRAPH_CLIENT_ID=your-application-client-id
# GRAPH_CLIENT_SECRET=your-application-client-secret
# GRAPH_SENDER_EMAIL=hub@kinetics.co.nz

# Existing SMTP delivery
# Without these, emails are suppressed and logged to console instead.
# SMTP_HOST=smtp.yourmailprovider.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-username
# SMTP_PASS=your-smtp-password
# SMTP_FROM=noreply@yourdomain.com
